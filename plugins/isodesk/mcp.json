{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "isodesk": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--frozen", "--directory", "${PLUGIN_ROOT}/server", "python", "-m", "isodesk.mcp_server"],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv"
      }
    }
  }
}
